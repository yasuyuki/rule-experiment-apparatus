{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apparatus/subject.schema.json",
  "title": "Versioned subject adapter descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "protocolVersion", "adapter", "profileRef"],
  "properties": {
    "id": { "$ref": "#/$defs/identifier" },
    "protocolVersion": { "const": 1 },
    "adapter": {
      "type": "object", "additionalProperties": false,
      "required": ["entrypoint", "sha256"],
      "properties": {
        "entrypoint": { "type": "string", "minLength": 1, "pattern": "^[^\\\\]+$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "profileRef": { "$ref": "#/$defs/identifier" }
  },
  "$defs": {
    "identifier": {
      "type": "string", "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$", "not": { "enum": [".", ".."] }
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
