{
  "id": "claude-code",
  "tool": "claude",
  "isolationEnv": "CLAUDE_CONFIG_DIR",
  "versionCommand": "claude --version",
  "binary": "claude",
  "markerFile": "CLAUDE.md",
  "credentialPaths": [".credentials.json", ".claude.json"],
  "workspacePlacement": [
    { "path": ".claude/rules/*.md", "proven": true }
  ],
  "keepEmpty": ["CLAUDE.md", ".cursorrules"],
  "transcripts": {
    "glob": "projects/*/*.jsonl",
    "armBinding": "project-slug",
    "participation": { "jsonlField": "type", "equals": "assistant" }
  }
}
