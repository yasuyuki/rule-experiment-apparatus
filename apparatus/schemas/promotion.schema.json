{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apparatus/promotion.schema.json",
  "title": "Promotion record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "cycle", "recordedAt", "status", "reviewSha256",
    "treatmentDigest", "oldManagedDigest", "oldStableCommit", "newStableCommit", "reasons"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "cycle": { "$ref": "#/$defs/identifier" },
    "recordedAt": { "$ref": "#/$defs/timestamp" },
    "status": { "enum": ["not-promoted", "prepared", "promoted"] },
    "reviewSha256": { "$ref": "#/$defs/sha256" },
    "treatmentDigest": { "$ref": "#/$defs/sha256" },
    "oldManagedDigest": { "$ref": "#/$defs/sha256" },
    "oldStableCommit": { "$ref": "#/$defs/gitObject" },
    "newStableCommit": { "oneOf": [{ "$ref": "#/$defs/gitObject" }, { "type": "null" }] },
    "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitObject": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
