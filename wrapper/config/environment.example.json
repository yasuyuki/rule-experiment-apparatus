{
  "schemaVersion": 2,
  "cursor": {
    "executable": "%LOCALAPPDATA%\\Programs\\cursor\\Cursor.exe"
  },
  "instances": {
    "stable": {
      "wslDistro": "<stable-distro>",
      "wslUser": "<stable-user>",
      "wslHome": "/home/<stable-user>",
      "projectsRoot": "/home/<stable-user>/Projects",
      "releasesRoot": "/home/<stable-user>/releases",
      "userProfile": null,
      "userDataDir": null,
      "extensionsDir": null
    },
    "candidate": {
      "wslDistro": "<candidate-distro>",
      "wslUser": "<candidate-user>",
      "wslHome": "/home/<candidate-user>",
      "projectsRoot": "/home/<candidate-user>/Projects",
      "releasesRoot": "/home/<candidate-user>/releases",
      "userProfile": "..\\foundation-candidate\\home",
      "userDataDir": "..\\foundation-candidate\\user-data",
      "extensionsDir": "..\\foundation-candidate\\home\\.cursor\\extensions"
    }
  },
  "controlPlane": {
    "gitInstance": "candidate"
  },
  "repositoryDiscovery": {
    "namePatterns": [
      "foundation*"
    ],
    "origins": [
      "https://github.com/<owner>/<repository>.git"
    ]
  },
  "storage": {
    "backupRoot": "..\\private-control-backups",
    "verificationRoot": "..\\private-control-verification",
    "localDataRoot": "C:\\Users\\<user>\\local-data"
  },
  "workspace": {
    "repositories": [
      {
        "relativePath": "example-app",
        "origin": "https://github.com/<owner>/example-app.git"
      },
      {
        "relativePath": "example-app-ui",
        "origin": "https://github.com/<owner>/example-app.git"
      },
      {
        "relativePath": "example-player",
        "origin": "https://github.com/<owner>/example-player.git"
      }
    ]
  },
  "projects": {
    "home": {
      "stable": {
        "kind": "wsl",
        "path": "/home/<stable-user>"
      },
      "candidate": {
        "kind": "wsl",
        "path": "/home/<candidate-user>"
      }
    },
    "example-windows": {
      "stable": {
        "kind": "windows",
        "path": "..\\example-project"
      },
      "candidate": {
        "kind": "windows",
        "path": "..\\example-project"
      }
    },
    "example-ssh": {
      "candidate": {
        "kind": "ssh",
        "authority": "example-agent",
        "path": "/srv/example-agent/project",
        "expectedUser": "example-agent"
      }
    }
  }
}
