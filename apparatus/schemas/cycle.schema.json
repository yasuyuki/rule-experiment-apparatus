{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apparatus/cycle.schema.json",
  "title": "Cycle declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cycle", "experiment", "kind", "subjects", "workloadHash",
    "measurementHash", "sessionContractHash", "executionUnitHash", "base", "arms"
  ],
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "measurement" } } },
      "then": {
        "required": ["judgeHash"],
        "properties": {
          "arms": {
            "minItems": 2, "maxItems": 2,
            "contains": { "properties": { "role": { "const": "control" } }, "required": ["role"] },
            "minContains": 1, "maxContains": 1
          }
        }
      },
      "else": {
        "not": { "required": ["judgeHash"] },
        "properties": { "arms": { "minItems": 1, "maxItems": 1 } }
      }
    }
  ],
  "properties": {
    "cycle": { "$ref": "#/$defs/identifier" },
    "experiment": { "$ref": "#/$defs/identifier" },
    "kind": { "enum": ["measurement", "estimation"] },
    "subjects": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "workloadHash": { "$ref": "#/$defs/sha256" },
    "measurementHash": { "$ref": "#/$defs/sha256" },
    "judgeHash": { "$ref": "#/$defs/sha256" },
    "sessionContractHash": { "$ref": "#/$defs/sha256" },
    "executionUnitHash": { "$ref": "#/$defs/sha256" },
    "base": {
      "type": "object", "additionalProperties": false,
      "required": ["repo", "commit"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "commit": { "$ref": "#/$defs/gitObject" }
      }
    },
    "readableMeta": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "pattern": "^[^\\\\]+$" }
    },
    "metaReadabilityHash": { "$ref": "#/$defs/sha256" },
    "arms": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "role", "variant", "variantTree"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "role": { "enum": ["control", "treatment"] },
          "variant": { "$ref": "#/$defs/identifier" },
          "variantTree": { "$ref": "#/$defs/gitObject" }
        }
      }
    }
  },
  "dependentRequired": {
    "readableMeta": ["metaReadabilityHash"],
    "metaReadabilityHash": ["readableMeta"]
  },
  "$defs": {
    "identifier": {
      "type": "string", "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$", "not": { "enum": [".", ".."] }
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitObject": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  }
}
