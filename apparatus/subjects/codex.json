{
  "id": "codex",
  "tool": "codex",
  "isolationEnv": "CODEX_HOME",
  "versionCommand": "codex --version",
  "binary": "codex",
  "markerFile": "AGENTS.md",
  "credentialPaths": ["auth.json"],
  "workspacePlacement": [
    { "path": "AGENTS.md", "proven": true }
  ],
  "keepEmpty": [],
  "transcripts": {
    "glob": "sessions/**/rollout-*.jsonl",
    "armBinding": "session-meta-cwd",
    "participation": {
      "all": [
        { "jsonlField": "type", "equals": "response_item" },
        { "jsonlField": "payload.role", "equals": "assistant" }
      ]
    }
  }
}
