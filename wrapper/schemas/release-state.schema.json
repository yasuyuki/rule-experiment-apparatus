{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/private-control/release-state.schema.json",
  "title": "Foundation runtime state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generation",
    "baseline",
    "run",
    "previousBaseline",
    "lastTransition",
    "transitionHistory"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "generation": { "type": "integer", "minimum": 0 },
    "baseline": { "$ref": "#/$defs/baseline" },
    "run": { "anyOf": [{ "$ref": "#/$defs/run" }, { "type": "null" }] },
    "previousBaseline": {
      "anyOf": [{ "$ref": "#/$defs/previousBaseline" }, { "type": "null" }]
    },
    "lastTransition": { "$ref": "#/$defs/transition" },
    "transitionHistory": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/transition" }
    }
  },
  "$defs": {
    "releaseBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "instance", "path", "gitRef"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "instance": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "gitRef": { "type": "string", "minLength": 1 }
      }
    },
    "baseline": {
      "allOf": [
        { "$ref": "#/$defs/releaseBase" },
        {
          "type": "object",
          "properties": { "instance": { "const": "stable" } }
        }
      ]
    },
    "run": {
      "allOf": [
        { "$ref": "#/$defs/releaseBase" },
        {
          "type": "object",
          "properties": { "instance": { "const": "candidate" } }
        }
      ]
    },
    "previousBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "commit", "gitRef", "backupManifest", "backupSha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 },
        "gitRef": { "type": "string", "minLength": 1 },
        "backupManifest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\:]+$"
        },
        "backupSha256": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$"
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "at"],
      "properties": {
        "action": {
          "enum": ["bootstrap", "seed", "promote", "discard", "rollback", "migrate-runtime-model"]
        },
        "at": { "type": "string", "format": "date-time" },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 },
        "release": { "type": "string", "minLength": 1 },
        "historyImported": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": ["bootstrap", "promote", "rollback", "migrate-runtime-model"]
              }
            },
            "required": ["action"]
          },
          "then": { "required": ["from", "to", "commit"] }
        },
        {
          "if": {
            "properties": { "action": { "enum": ["seed", "discard"] } },
            "required": ["action"]
          },
          "then": { "required": ["release", "commit"] }
        }
      ]
    }
  }
}
