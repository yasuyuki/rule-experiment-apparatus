{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apparatus/calibration-record.schema.json",
  "title": "Calibration record (schemaVersion 1)",
  "description": "推定器ごとの較正記録の正本（foundation-control/calibrations/<estimatorId>.json）。正解データは計測済みサイクル（対照アームがあり、記録が有効なもの）から derive_ground_truth() で導出し、片アームだけを凍結して計測結果を伏せた推定と突き合わせる。較正は実験サイクル中に行わない（憲法 §1 の前提条件を確立する操作）。verdict 等の禁止キーは additionalProperties: false と cycle.py の _reject_forbidden_keys の両方で防ぐ（多層防御）。calibrationHash・estimator.identity・frozenInput.manifest との整合など、フィールド間の条件は cycle.py の validate_calibration_record() が持つ。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "estimator", "calibrations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "calibration-record" },
    "estimator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" }
      }
    },
    "calibrations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/calibration" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}"
    },
    "estimatorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "identity", "components"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "identity": { "$ref": "#/$defs/sha256" },
        "components": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z0-9._-]+$": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attributable", "basis"],
      "properties": {
        "attributable": { "enum": ["attributable", "not-attributable", "indeterminate"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["memberId", "locator"],
            "properties": {
              "memberId": { "$ref": "#/$defs/identifier" },
              "locator": { "type": "string", "minLength": 1 },
              "note": { "type": "string" }
            }
          }
        },
        "rejectedInterpretations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["interpretation", "reason"],
            "properties": {
              "interpretation": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "groundTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attributable", "comparedCriteria", "differingCriteria", "derivation"],
      "properties": {
        "attributable": { "enum": ["attributable", "not-attributable"] },
        "comparedCriteria": {
          "type": "array",
          "items": { "type": "integer", "minimum": 2 }
        },
        "differingCriteria": {
          "type": "array",
          "items": { "type": "integer", "minimum": 2 }
        },
        "derivation": { "type": "string", "minLength": 1 }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibratedAt",
        "calibrationHash",
        "estimator",
        "source",
        "frozenInput",
        "estimate",
        "groundTruth",
        "agreement"
      ],
      "properties": {
        "calibratedAt": { "$ref": "#/$defs/timestamp" },
        "calibrationHash": { "$ref": "#/$defs/sha256" },
        "estimator": { "$ref": "#/$defs/estimatorRef" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cycle", "arm", "recordPath", "recordSha256"],
          "properties": {
            "cycle": { "$ref": "#/$defs/identifier" },
            "arm": { "$ref": "#/$defs/identifier" },
            "recordPath": { "type": "string", "minLength": 1 },
            "recordSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "frozenInput": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hash", "manifest"],
          "properties": {
            "hash": { "$ref": "#/$defs/sha256" },
            "manifest": { "type": "object" }
          }
        },
        "estimate": { "$ref": "#/$defs/estimate" },
        "groundTruth": { "$ref": "#/$defs/groundTruth" },
        "agreement": { "enum": ["match", "mismatch", "indeterminate"] }
      }
    }
  }
}
