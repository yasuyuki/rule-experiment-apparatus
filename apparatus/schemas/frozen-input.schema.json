{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apparatus/frozen-input.schema.json",
  "title": "Frozen input manifest",
  "type": "object", "additionalProperties": false,
  "required": [
    "schemaVersion", "kind", "cycle", "experiment", "arm", "armRole", "variant",
    "variantTree", "subjects", "declarationSha256", "workloadSha256",
    "measurementSha256", "commitRange", "sessions", "members"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "frozen-input" },
    "cycle": { "$ref": "#/$defs/identifier" },
    "experiment": { "$ref": "#/$defs/identifier" },
    "arm": { "$ref": "#/$defs/identifier" },
    "armRole": { "enum": ["control", "treatment"] },
    "variant": { "$ref": "#/$defs/identifier" },
    "variantTree": { "$ref": "#/$defs/gitObject" },
    "subjects": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "version", "configIdentity"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "version": { "type": "string", "minLength": 1 },
          "configIdentity": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "declarationSha256": { "$ref": "#/$defs/sha256" },
    "workloadSha256": { "$ref": "#/$defs/sha256" },
    "measurementSha256": { "$ref": "#/$defs/sha256" },
    "commitRange": {
      "type": "object", "additionalProperties": false,
      "required": ["base", "injection", "head", "commits"],
      "properties": {
        "base": { "$ref": "#/$defs/gitObject" },
        "injection": { "$ref": "#/$defs/gitObject" },
        "head": { "$ref": "#/$defs/gitObject" },
        "commits": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["commit", "authorTime"],
            "properties": {
              "commit": { "$ref": "#/$defs/gitObject" },
              "authorTime": { "$ref": "#/$defs/timestamp" }
            }
          }
        }
      }
    },
    "sessions": { "type": "array", "items": { "$ref": "#/$defs/session" } },
    "members": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "path", "source", "sha256", "bytes"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "kind": { "enum": ["declaration", "workload", "measurement", "artifact-diff", "transcript"] },
          "path": { "type": "string", "pattern": "^payload/" },
          "source": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitObject": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "session": {
      "type": "object", "additionalProperties": false,
      "required": ["tool", "path", "span", "assistantCount", "belonging"],
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "span": {
          "type": "object", "additionalProperties": false, "required": ["start", "end"],
          "properties": {
            "start": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/timestamp" }] },
            "end": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/timestamp" }] }
          }
        },
        "assistantCount": { "type": "integer", "minimum": 0 },
        "belonging": { "enum": ["belongs", "does-not-belong", "unclassifiable"] },
        "belongingReason": { "type": "string" }
      }
    }
  }
}
