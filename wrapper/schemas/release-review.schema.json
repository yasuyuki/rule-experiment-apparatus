{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/private-control/release-review.schema.json",
  "title": "Foundation release review record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "release", "generation", "baseCommit", "late", "intent", "review"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "release": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "generation": { "type": "integer" },
    "baseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "late": { "type": "boolean" },
    "intent": { "$ref": "#/$defs/intent" },
    "review": { "anyOf": [{ "$ref": "#/$defs/review" }, { "type": "null" }] }
  },
  "allOf": [
    { "if": { "required": ["review"], "properties": { "review": { "type": "object" } } },
      "then": { "properties": { "intent": { "$ref": "#/$defs/intentComplete" } } } },
    { "if": { "required": ["late"], "properties": { "late": { "const": false } } },
      "then": { "properties": { "intent": { "$ref": "#/$defs/intentComplete" } } } }
  ],
  "$defs": {
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordedAt", "goal", "expectedEffects", "successCriteria", "nonGoals"],
      "properties": {
        "recordedAt": { "type": "string", "minLength": 1 },
        "goal": { "type": "string" },
        "expectedEffects": { "type": "array", "items": { "type": "string" } },
        "successCriteria": { "type": "array", "items": { "type": "string" } },
        "nonGoals": { "type": "array", "items": { "type": "string" } }
      }
    },
    "intentComplete": {
      "allOf": [{ "$ref": "#/$defs/intent" }],
      "properties": {
        "goal": { "type": "string", "minLength": 1 },
        "successCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewedAt",
        "reviewedCommit",
        "correctness",
        "procedure",
        "criteriaResults",
        "observedEffects",
        "procedureChecks",
        "betterProcedure",
        "verdict"
      ],
      "properties": {
        "reviewedAt": { "type": "string", "minLength": 1 },
        "reviewedCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "reviewedRepositories": {
          "type": "array",
          "items": { "$ref": "#/$defs/reviewedRepository" }
        },
        "correctness": { "enum": ["pass", "partial", "fail"] },
        "procedure": { "enum": ["good", "acceptable", "needs-improvement"] },
        "criteriaResults": {
          "type": "array",
          "items": { "$ref": "#/$defs/criteriaResult" },
          "comment": "Must correspond 1:1 (order-independent) with intent.successCriteria; not enforceable by JSON Schema alone, see Assert-FoundationReviewRecordShape."
        },
        "observedEffects": { "type": "array", "items": { "type": "string" } },
        "procedureChecks": { "$ref": "#/$defs/procedureChecks" },
        "betterProcedure": { "type": "string", "minLength": 1 },
        "verdict": { "enum": ["accepted", "needs-work", "rejected"] }
      }
    },
    "reviewedRepository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "headCommit"],
      "properties": {
        "relativePath": { "type": "string", "minLength": 1 },
        "headCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "criteriaResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion", "result", "evidence"],
      "properties": {
        "criterion": { "type": "string" },
        "result": { "enum": ["met", "unmet", "unknown"] },
        "evidence": { "type": "string" }
      }
    },
    "procedureChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimalChange", "verifiedBeforeProceeding", "rollbackPreserved", "stableIsolationUsed"],
      "properties": {
        "minimalChange": { "enum": ["yes", "no", "na"] },
        "verifiedBeforeProceeding": { "enum": ["yes", "no", "na"] },
        "rollbackPreserved": { "enum": ["yes", "no", "na"] },
        "stableIsolationUsed": { "enum": ["yes", "no", "na"] }
      }
    }
  }
}
