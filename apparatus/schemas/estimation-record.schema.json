{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apparatus/estimation-record.schema.json",
  "title": "Estimation record (schemaVersion 1)",
  "description": "推定記録の形の正本。計測記録（cycle-record.schema.json）とは別ファイル・別ディレクトリ（foundation-control/estimations/<cycle>.json）に置く。用途は triage 専用（use は const）。verdict/promote 等の禁止キーは additionalProperties: false と cycle.py の _reject_forbidden_keys の両方で防ぐ（多層防御、憲法 不変条件 10）。frozenInput.manifest の content_hash 照合・estimator.identity の再計算・basis[].memberId の存在確認など、アーム間・フィールド間の条件は JSON Schema で書けないので cycle.py の validate_estimation_record() が持つ。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "cycle", "experiment", "estimations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "estimation-record" },
    "cycle": { "$ref": "#/$defs/identifier" },
    "experiment": { "$ref": "#/$defs/identifier" },
    "estimations": {
      "type": "array",
      "items": { "$ref": "#/$defs/estimation" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}"
    },
    "estimator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "identity", "components"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "identity": { "$ref": "#/$defs/sha256" },
        "components": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z0-9._-]+$": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attributable", "basis"],
      "properties": {
        "attributable": { "enum": ["attributable", "not-attributable", "indeterminate"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["memberId", "locator"],
            "properties": {
              "memberId": { "$ref": "#/$defs/identifier" },
              "locator": { "type": "string", "minLength": 1 },
              "note": { "type": "string" }
            }
          }
        },
        "rejectedInterpretations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["interpretation", "reason"],
            "properties": {
              "interpretation": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "estimation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimatedAt", "use", "estimator", "frozenInput", "calibrations", "estimate"],
      "properties": {
        "estimatedAt": { "$ref": "#/$defs/timestamp" },
        "use": { "const": "triage" },
        "estimator": { "$ref": "#/$defs/estimator" },
        "frozenInput": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hash", "arm", "manifest"],
          "properties": {
            "hash": { "$ref": "#/$defs/sha256" },
            "arm": { "$ref": "#/$defs/identifier" },
            "manifest": { "type": "object" }
          }
        },
        "calibrations": {
          "description": "この estimator identity を使用可にした較正の参照。1件以上（較正0件の推定器は拒否される）。",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cycle", "arm", "frozenInputHash", "calibrationHash", "agreement"],
            "properties": {
              "cycle": { "$ref": "#/$defs/identifier" },
              "arm": { "$ref": "#/$defs/identifier" },
              "frozenInputHash": { "$ref": "#/$defs/sha256" },
              "calibrationHash": { "$ref": "#/$defs/sha256" },
              "agreement": { "enum": ["match", "mismatch", "indeterminate"] }
            }
          }
        },
        "estimate": { "$ref": "#/$defs/estimate" }
      }
    }
  }
}
