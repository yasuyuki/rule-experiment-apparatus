{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apparatus/cycle-record.schema.json",
  "title": "Cycle record",
  "type": "object", "additionalProperties": false,
  "required": [
    "schemaVersion", "cycle", "experiment", "recordedAt", "subjects",
    "baseCommit", "measurementSha256", "executionSha256", "arms"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "cycle": { "$ref": "#/$defs/identifier" },
    "experiment": { "$ref": "#/$defs/identifier" },
    "recordedAt": { "$ref": "#/$defs/timestamp" },
    "subjects": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
    "baseCommit": { "$ref": "#/$defs/gitObject" },
    "measurementSha256": { "$ref": "#/$defs/sha256" },
    "executionSha256": { "$ref": "#/$defs/sha256" },
    "arms": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "id", "role", "variant", "variantTree", "variantInjectionCommit", "armCommit",
          "workloadSha256", "judgeSha256", "judgeExitCode", "criteria"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "role": { "enum": ["control", "treatment"] },
          "variant": { "$ref": "#/$defs/identifier" },
          "variantTree": { "$ref": "#/$defs/gitObject" },
          "variantInjectionCommit": { "$ref": "#/$defs/gitObject" },
          "armCommit": { "$ref": "#/$defs/gitObject" },
          "workloadSha256": { "$ref": "#/$defs/sha256" },
          "judgeSha256": { "$ref": "#/$defs/sha256" },
          "judgeExitCode": { "enum": [0, 1] },
          "criteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/criterion" } }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitObject": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "criterion": {
      "type": "object", "additionalProperties": false,
      "required": ["criterion", "text", "result", "evidence"],
      "properties": {
        "criterion": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1 },
        "result": { "enum": ["met", "not-met", "unknown"] },
        "evidence": { "type": "string", "minLength": 1 }
      }
    }
  }
}
