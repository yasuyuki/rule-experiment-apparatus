{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apparatus/handoff.schema.json",
  "title": "Cycle handoff record",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "cycle", "recordedAt", "arms"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "cycle": { "$ref": "#/$defs/identifier" },
    "recordedAt": { "$ref": "#/$defs/timestamp" },
    "arms": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "subjects"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "subjects": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "version", "configIdentity", "configRoot", "launch"],
              "properties": {
                "id": { "$ref": "#/$defs/identifier" },
                "version": { "type": "string", "minLength": 1 },
                "configIdentity": { "$ref": "#/$defs/sha256" },
                "configRoot": { "type": "string", "minLength": 1 },
                "launch": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
