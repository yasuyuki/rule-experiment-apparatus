{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apparatus/cycle.schema.json",
  "title": "Measurement cycle declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cycle", "experiment", "subjects", "workload", "evaluation", "base", "arms"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "cycle": { "$ref": "#/$defs/identifier" },
    "experiment": { "$ref": "#/$defs/identifier" },
    "subjects": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "workload": { "$ref": "#/$defs/artifact" },
    "evaluation": { "$ref": "#/$defs/artifact" },
    "base": {
      "type": "object", "additionalProperties": false,
      "required": ["repo", "commit"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "commit": { "$ref": "#/$defs/gitObject" }
      }
    },
    "materials": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "repo", "commit"],
        "properties": {
          "name": { "$ref": "#/$defs/identifier" },
          "repo": { "type": "string", "minLength": 1 },
          "commit": { "$ref": "#/$defs/gitObject" }
        }
      }
    },
    "arms": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "contains": {
        "type": "object", "required": ["role"],
        "properties": { "role": { "const": "control" } }
      },
      "minContains": 1, "maxContains": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "role", "variant", "variantTree", "variantDigest"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "role": { "enum": ["control", "treatment"] },
          "variant": { "$ref": "#/$defs/identifier" },
          "variantTree": { "$ref": "#/$defs/gitObject" },
          "variantDigest": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string", "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$", "not": { "enum": [".", ".."] }
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitObject": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "^[^\\\\]+$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
