{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apparatus/adapter-prepare.schema.json",
  "title": "Subject adapter prepare response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion", "adapterIdentity", "subjectVersion", "configIdentity",
    "variantDigest", "placements", "launch", "token"
  ],
  "properties": {
    "protocolVersion": { "const": 1 },
    "adapterIdentity": { "$ref": "#/$defs/sha256" },
    "subjectVersion": { "type": "string", "minLength": 1 },
    "configIdentity": { "$ref": "#/$defs/sha256" },
    "variantDigest": { "$ref": "#/$defs/sha256" },
    "placements": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "launch": { "type": "string", "minLength": 1 },
    "token": {}
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
