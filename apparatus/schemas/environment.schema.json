{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apparatus/environment.schema.json",
  "title": "Rule experiment environment",
  "type": "object",
  "additionalProperties": false,
  "required": ["executor", "variantSourceRoot", "stableRules", "runsRoot", "profiles"],
  "properties": {
    "executor": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "distro", "user"],
          "properties": {
            "kind": { "const": "wsl" },
            "distro": { "type": "string", "minLength": 1 },
            "user": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "local-posix" } }
        }
      ]
    },
    "variantSourceRoot": { "type": "string", "minLength": 1 },
    "stableRules": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "branch"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 }
      }
    },
    "runsRoot": { "type": "string", "minLength": 1 },
    "profiles": {
      "type": "object", "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z0-9._-]+$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
