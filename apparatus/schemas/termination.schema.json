{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apparatus/termination.schema.json",
  "title": "Immutable cycle termination record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "cycle", "recordedAt", "status", "reason", "declarationSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "cycle": { "$ref": "#/$defs/identifier" },
    "recordedAt": { "$ref": "#/$defs/timestamp" },
    "status": { "enum": ["abandoned", "failed"] },
    "reason": { "type": "string", "pattern": ".*\\S.*" },
    "declarationSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
