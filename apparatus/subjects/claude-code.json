{
  "id": "claude-code",
  "isolationEnv": "CLAUDE_CONFIG_DIR",
  "isolationComplete": true,
  "versionCommand": "claude --version",
  "binary": "claude",
  "configRoot": {
    "alwaysApplyFile": "CLAUDE.md",
    "emptyRulesDir": "rules",
    "credentialDest": ".credentials.json",
    "credentialSource": "~/.claude/.credentials.json"
  },
  "workspacePlacement": [
    { "path": ".claude/rules/*.md", "proven": true },
    { "path": "CLAUDE.md", "proven": true }
  ],
  "configRootPlacement": [
    { "path": "CLAUDE.md", "proven": true },
    { "path": "rules/*.md", "proven": true }
  ],
  "keepEmpty": ["rules", ".claude/rules"],
  "transcripts": {
    "glob": "projects/*/*.jsonl",
    "armBinding": "project-slug",
    "participation": { "jsonlField": "type", "equals": "assistant" }
  },
  "login": "credential-file"
}
